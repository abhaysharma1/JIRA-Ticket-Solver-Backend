# Copy to .env and adjust.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jira_agent?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jira_agent_test?schema=public"
JWT_SECRET="" # optional: leave empty to auto-generate and persist .data/jwt.secret
JWT_EXPIRES_IN="30d"
PORT=4000
# Public base URL used to build JIRA webhook URLs (defaults to http://localhost:PORT)
PUBLIC_BASE_URL=""
